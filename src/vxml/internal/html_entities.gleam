}

fn from_codepoint(codepoint: Int, entity: String) -> String {
  case string.utf_codepoint(codepoint) {
    Ok(utf_codepoint) -> string.from_utf_codepoints([utf_codepoint])
    Error(_) -> entity
  }
}

