    Ok(codepoint) -> from_codepoint(codepoint, entity)
    Error(_) -> entity
  }
}

/// Decodes a decimal reference body (without `&#` and `;`). Returns the
/// input unchanged if it is not a valid code point.
pub fn decode_dec(entity: String) -> String {
