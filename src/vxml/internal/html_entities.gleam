/// Encodes, after NFC normalisation, every character that has a named
/// HTML entity, except newline and tab. Other characters are unchanged.
pub fn encode_named(text: String) -> String {
  encode_named_loop(normalise(text), "")
}

fn encode_named_loop(text: String, encoded: String) -> String {
  case string.pop_grapheme(text) {
    Error(Nil) -> encoded
    Ok(#(grapheme, after_grapheme)) -> {
      let found = case string.to_utf_codepoints(grapheme) {
        [first, ..] ->
          encode_block(string.utf_codepoint_to_int(first) / 64, text)
        [] -> Error(Nil)
      }
      case found {
        Ok(#(entity, rest)) -> encode_named_loop(rest, encoded <> entity)
        Error(Nil) -> encode_named_loop(after_grapheme, encoded <> grapheme)
      }
    }
  }
}

